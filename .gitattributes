# Los scripts que se ejecutan dentro de los contenedores Linux (MySQL, Nginx)
# deben conservar el fin de línea LF aunque el repositorio se clone en
# Windows: con CRLF, MySQL no puede ejecutar 99-privilegios-aplicacion.sh y la
# base queda a medio crear.
*.sh        text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
.env.example text eol=lf

# Scripts de Windows
*.ps1       text eol=crlf
