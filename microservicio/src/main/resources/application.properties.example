spring.application.name=microservicio

server.port=${SERVER_PORT:8081}

# --- Base de datos (cada integrante usa sus propias credenciales) ---
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/inventario_andamios}
spring.datasource.username=${DB_USERNAME:TU_USUARIO_MYSQL}
spring.datasource.password=${DB_PASSWORD:TU_PASSWORD_MYSQL}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=${SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# --- Seguridad (Sprint 1: HU-03, HU-08, HU-09) ---
# Secreto para firmar los tokens: minimo 32 caracteres. En el servidor se define con la variable JWT_SECRET.
app.jwt.secret=${JWT_SECRET:}
# Vigencia del token de acceso y tiempo maximo de inactividad, en minutos
app.jwt.access-ttl-minutos=15
app.jwt.inactividad-minutos=30

# Origenes del cliente web autorizados (separados por comas)
app.cors.origenes=${CORS_ORIGENES:http://localhost:4200}

# Administrador inicial: solo se crea si la tabla de usuarios esta vacia
app.admin.correo=${ADMIN_CORREO:}
app.admin.password=${ADMIN_PASSWORD:}

# No exponer detalles tecnicos en las respuestas de error
server.error.include-stacktrace=never
server.error.include-message=never

# --- Sprint 4: endurecimiento y observabilidad (HU-35, HU-38, HU-41) ---
# Bloqueo de cuenta tras intentos fallidos consecutivos
app.seguridad.intentos-maximos=5
app.seguridad.minutos-bloqueo=15
# Intentos de autenticacion admitidos por origen y por minuto
app.seguridad.limite-intentos-por-minuto=${LIMITE_INTENTOS_MINUTO:10}

# Tamano maximo de los archivos de carga masiva
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=2MB

# Solo el estado del servicio, sin detalles internos
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never
management.endpoint.health.probes.enabled=true

# Cada linea del registro lleva la solicitud y el usuario que la origino
logging.pattern.level=%5p [sol=%X{solicitud:-} usr=%X{usuario:-}]

# Detras del proxy inverso, la IP real llega en X-Forwarded-For. Activar SOLO
# cuando el backend no es accesible directamente (ver docker-compose.yml).
server.forward-headers-strategy=${FORWARD_HEADERS:none}
