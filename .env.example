# Copie este archivo como .env y complete los valores antes de
# "docker compose up". El archivo .env NO se sube al repositorio.
#
# Genere valores aleatorios, por ejemplo:
#   openssl rand -base64 24     (contraseñas)
#   openssl rand -base64 48     (JWT_SECRET)

MYSQL_ROOT_PASSWORD=
MYSQL_USER=inventario
MYSQL_PASSWORD=

# Clave para firmar los tokens de sesión: mínimo 32 caracteres.
JWT_SECRET=

# Puerto en el que se publica el sistema y origen permitido para el navegador.
PUERTO_WEB=8080
CORS_ORIGENES=http://localhost:8080

# Solo en producción con HTTPS (docker-compose.https.yml): el nombre DNS del
# servidor. Con HTTPS, use PUERTO_WEB=127.0.0.1:8080 y CORS_ORIGENES=https://DOMINIO
DOMINIO=
